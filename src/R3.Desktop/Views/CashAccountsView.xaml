<UserControl x:Class="R3.Desktop.Views.CashAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:R3.Desktop.ViewModels"
             xmlns:local="clr-namespace:R3.Desktop"
             d:DataContext="{d:DesignInstance Type=vm:CashAccountsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <local:StatusBrushConverter x:Key="StatusBrush" />
            <local:BalanceStatusBrushConverter x:Key="BalanceStatusBrush" />
            <Geometry x:Key="AddActionIcon">M12,3 A9,9 0 1 1 12,21 A9,9 0 1 1 12,3 M12,7 L12,17 M7,12 L17,12</Geometry>
            <Geometry x:Key="EditActionIcon">M4,20 L8,19 L19,8 L16,5 L5,16 Z M14.5,6.5 L17.5,9.5 M4,20 L9,20</Geometry>
            <Geometry x:Key="StatementActionIcon">M6,3 L15,3 L19,7 L19,21 L6,21 Z M15,3 L15,7 L19,7 M9,11 L16,11 M9,15 L16,15 M9,18 L14,18</Geometry>
            <Geometry x:Key="CashInActionIcon">M12,3 L12,15 M6,10 L12,16 L18,10 M5,20 L19,20</Geometry>
            <Geometry x:Key="CashOutActionIcon">M12,16 L12,4 M6,10 L12,4 L18,10 M5,20 L19,20</Geometry>
            <Geometry x:Key="TransferActionIcon">M4,8 L16,8 M12,4 L16,8 L12,12 M20,16 L8,16 M12,20 L8,16 L12,12</Geometry>
            <Geometry x:Key="RefreshActionIcon">M20,7 L20,3 L16,3 M19,4 C15,-0.2 7,1 4,6 C1,11 3,18 8,20 C13,23 19,20 21,15 M4,17 L4,21 L8,21</Geometry>
            <Geometry x:Key="SearchActionIcon">M10.5,4 A6.5,6.5 0 1 1 10.5,17 A6.5,6.5 0 1 1 10.5,4 M15.2,15.2 L21,21</Geometry>
            <Style x:Key="CompactToolbarButton" TargetType="{x:Type ui:Button}">
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="64" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="Margin" Value="0,0,5,0" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,9">
            <TextBlock Text="{Binding Title}" FontSize="{StaticResource R3.Font.Title}" FontWeight="SemiBold" Foreground="{StaticResource R3.Text.Primary.Brush}" />
            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource R3.Text.Secondary.Brush}" FontSize="{StaticResource R3.Font.Grid}" Margin="0,2,0,0" />
        </StackPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource R3.Surface.Alt.Brush}" BorderBrush="{StaticResource R3.Border.Brush}" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:Button x:Name="NewButton" Click="NewButton_Click" Style="{StaticResource CompactToolbarButton}" Appearance="Primary" ToolTip="Yeni kasa oluştur">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource AddActionIcon}" Width="13" Height="13" Stretch="Uniform" Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round"/><TextBlock Text="Yeni Kasa" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    </ui:Button>
                    <ui:Button x:Name="EditButton" Click="EditButton_Click" Style="{StaticResource CompactToolbarButton}" ToolTip="Seçili kasayı düzenle">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource EditActionIcon}" Width="13" Height="13" Stretch="Uniform" Stroke="#4A4A4A" StrokeThickness="1.8" StrokeLineJoin="Round"/><TextBlock Text="Düzenle" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    </ui:Button>
                    <ui:Button Click="StatementButton_Click" Style="{StaticResource CompactToolbarButton}" ToolTip="Seçili kasanın ekstresini aç">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource StatementActionIcon}" Width="13" Height="13" Stretch="Uniform" Stroke="#666666" StrokeThickness="1.7" StrokeLineJoin="Round"/><TextBlock Text="Ekstre" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    </ui:Button>
                    <Border Width="1" Background="{StaticResource R3.Surface.Selected.Brush}" Margin="3,3,8,3"/>
                    <ui:Button Click="CashInButton_Click" Style="{StaticResource CompactToolbarButton}" ToolTip="Seçili kasaya nakit giriş gir">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource CashInActionIcon}" Width="13" Height="13" Stretch="Uniform" Stroke="{StaticResource R3.Accent.Brush}" StrokeThickness="1.7" StrokeLineJoin="Round"/><TextBlock Text="Nakit Giriş" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    </ui:Button>
                    <ui:Button Click="CashOutButton_Click" Style="{StaticResource CompactToolbarButton}" ToolTip="Seçili kasadan nakit çıkış gir">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource CashOutActionIcon}" Width="13" Height="13" Stretch="Uniform" Stroke="{StaticResource R3.Warning.Brush}" StrokeThickness="1.7" StrokeLineJoin="Round"/><TextBlock Text="Nakit Çıkış" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    </ui:Button>
                    <ui:Button Click="TransferButton_Click" Style="{StaticResource CompactToolbarButton}" ToolTip="Kasalar arası transfer">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource TransferActionIcon}" Width="13" Height="13" Stretch="Uniform" Stroke="#929292" StrokeThickness="1.7" StrokeLineJoin="Round"/><TextBlock Text="Transfer" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    </ui:Button>
                    <ui:Button Command="{Binding RefreshCommand}" Style="{StaticResource CompactToolbarButton}" MinWidth="62" ToolTip="Listeyi yenile">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource RefreshActionIcon}" Width="13" Height="13" Stretch="Uniform" Stroke="#646464" StrokeThickness="1.7" StrokeLineJoin="Round"/><TextBlock Text="Yenile" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    </ui:Button>
                </StackPanel>
                <Grid Grid.Column="2" Width="280">
                    <Path Data="{StaticResource SearchActionIcon}" Width="13" Height="13" Stretch="Uniform" Stroke="#7A7A7A" StrokeThickness="1.7" HorizontalAlignment="Left" Margin="9,0,0,0" Panel.ZIndex="2" IsHitTestVisible="False"/>
                    <ui:TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="28,3,8,3" FontSize="10.5" PlaceholderText="Kasa kodu veya adı" />
                </Grid>
            </Grid>
        </Border>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="Firebrick" Margin="0,8,0,0" />
        <DataGrid x:Name="Grid" Style="{StaticResource ProfessionalDataGridStyle}" ItemsSource="{Binding CashAccounts}" SelectedItem="{Binding SelectedCashAccount}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Kasa Kodu" Binding="{Binding Code}" Width="110" />
                <DataGridTextColumn Header="Kasa Adı" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Şube" Binding="{Binding Branch}" Width="120" />
                <DataGridTextColumn Header="Tip" Binding="{Binding CashAccountTypeLabel}" Width="120" />
                <DataGridTextColumn Header="Para Birimi" Binding="{Binding CurrencyCode}" Width="90" />
                <DataGridTextColumn Header="Giriş" Binding="{Binding TotalIn, StringFormat=N2}" Width="100" />
                <DataGridTextColumn Header="Çıkış" Binding="{Binding TotalOut, StringFormat=N2}" Width="100" />
                <DataGridTextColumn Header="Bakiye" Binding="{Binding Balance, StringFormat=N2}" Width="110" />
                <DataGridTemplateColumn Header="Durum" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding StatusLabel, Converter={StaticResource StatusBrush}}" CornerRadius="9" Padding="8,2" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding StatusLabel}" Foreground="White" FontSize="{StaticResource R3.Font.Grid}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
