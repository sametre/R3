<Window x:Class="R3.Desktop.Views.CashTransferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:R3.Desktop.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:CashTransferViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
        Title="Kasalar Arası Transfer" Width="520" SizeToContent="Height" MinWidth="460" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="White" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="18">
        <TextBlock Text="Kasalar Arası Transfer" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <TextBlock Text="Kaynak Kasa *" Margin="0,0,0,5"/>
        <ComboBox ItemsSource="{Binding CashAccounts}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SourceCashAccountId}" Padding="8"/>
        <TextBlock Text="Hedef Kasa *" Margin="0,10,0,5"/>
        <ComboBox ItemsSource="{Binding CashAccounts}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding TargetCashAccountId}" Padding="8"/>
        <TextBlock Text="Tarih *" Margin="0,10,0,5"/><DatePicker SelectedDate="{Binding Date}"/>
        <TextBlock Text="Tutar *" Margin="0,10,0,5"/><ui:TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Açıklama" Margin="0,10,0,5"/><ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="60"/>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Vazgeç" IsCancel="True" Width="78" Height="30" Margin="0,0,7,0"/>
            <ui:Button Content="Kaydet" Command="{Binding SaveCommand}" Width="90" Height="30" Appearance="Primary" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
