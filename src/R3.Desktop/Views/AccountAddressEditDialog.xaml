<Window x:Class="R3.Desktop.Views.AccountAddressEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:R3.Desktop.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:AccountAddressEditViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
        Title="{Binding Title}" Width="440" Height="620" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="White" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

        <TextBlock Text="Adres Tipi *" Margin="0,10,0,5" />
        <ComboBox ItemsSource="{Binding AddressTypes}" SelectedItem="{Binding AddressType}" Padding="8" />

        <TextBlock Text="Adres Adı *" Margin="0,10,0,5" />
        <ui:TextBox Text="{Binding AddressTitle, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" />

        <TextBlock Text="Ülke" Margin="0,10,0,5" />
        <ui:TextBox Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" />

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"><TextBlock Text="İl"/><ui:TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="İlçe"/><ui:TextBox Text="{Binding District, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" Margin="0,5,0,0"/></StackPanel>
        </Grid>

        <TextBlock Text="Mahalle" Margin="0,10,0,5" />
        <ui:TextBox Text="{Binding Neighborhood, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" />

        <TextBlock Text="Adres *" Margin="0,10,0,5" />
        <ui:TextBox Text="{Binding AddressLine, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" Height="60" AcceptsReturn="True" TextWrapping="Wrap" />

        <TextBlock Text="Posta Kodu" Margin="0,10,0,5" />
        <ui:TextBox Text="{Binding PostalCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" />

        <TextBlock Text="Yetkili" Margin="0,10,0,5" />
        <ui:TextBox Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" />

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"><TextBlock Text="Telefon"/><ui:TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Cep Telefonu"/><ui:TextBox Text="{Binding MobilePhone, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" Margin="0,5,0,0"/></StackPanel>
        </Grid>

        <CheckBox Content="Varsayılan adres" IsChecked="{Binding IsDefault}" Margin="0,14,0,0" />

        <TextBlock Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,12,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Vazgeç" IsCancel="True" Width="78" Height="30" Padding="10,4" Margin="0,0,7,0" />
            <ui:Button Content="Kaydet" Command="{Binding SaveCommand}" Width="78" Height="30" Padding="10,4" Appearance="Primary" IsDefault="True" />
        </StackPanel>
    </StackPanel></ScrollViewer>
</Window>
