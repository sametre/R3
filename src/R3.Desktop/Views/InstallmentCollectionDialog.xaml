<Window x:Class="R3.Desktop.Views.InstallmentCollectionDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Taksit Tahsilatı" Width="940" Height="630" MinWidth="760" MinHeight="500"
 WindowStartupLocation="CenterOwner" Background="#F4F6F8" FontFamily="Segoe UI" PreviewKeyDown="OnPreviewKeyDown">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="11,6"/><Setter Property="Margin" Value="3,0"/><Setter Property="MinHeight" Value="30"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="6,4"/><Setter Property="BorderBrush" Value="#C8D2DC"/></Style>
 </Window.Resources>
 <DockPanel Margin="14">
  <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D4DCE5" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Taksit Tahsilatı" FontSize="18" FontWeight="SemiBold" Foreground="#263746"/>
     <TextBlock x:Name="CustomerText" Foreground="#627286" Margin="0,4,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Tahsilat tarihi" VerticalAlignment="Center" Margin="0,0,7,0"/><DatePicker x:Name="CollectionDate" Width="125"/></StackPanel>
   </Grid>
  </Border>
  <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D4DCE5" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="StatusText" Foreground="#526377" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="Ödeme yöntemi" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <ComboBox x:Name="PaymentMethodCombo" Width="145" SelectedIndex="0"><ComboBoxItem Tag="Cash">Nakit</ComboBoxItem><ComboBoxItem Tag="BankTransfer">Banka havalesi</ComboBoxItem><ComboBoxItem Tag="CreditCard">Kredi kartı</ComboBoxItem><ComboBoxItem Tag="Cheque">Çek</ComboBoxItem><ComboBoxItem Tag="PromissoryNote">Senet</ComboBoxItem></ComboBox>
     <TextBlock Text="Açıklama" VerticalAlignment="Center" Margin="16,0,8,0"/><TextBox x:Name="DescriptionBox" Width="250"/></StackPanel></StackPanel>
    <StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="Toplam Tahsilat" Foreground="#526377"/><TextBlock x:Name="TotalText" FontSize="20" FontWeight="SemiBold" Foreground="#167C82" Text="0,00"/></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Kapat" IsCancel="True"/><Button x:Name="CollectButton" Content="Tahsil Et" Click="Collect_Click" Background="#167C82" Foreground="White"/></StackPanel>
   </Grid>
  </Border>
  <DataGrid x:Name="InstallmentGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" RowHeight="30" HeadersVisibility="Column" Background="White" BorderBrush="#C8D2DC" BorderThickness="1" AlternatingRowBackground="#F8FAFC" CellEditEnding="InstallmentGrid_CellEditEnding" CurrentCellChanged="InstallmentGrid_CurrentCellChanged">
   <DataGrid.Columns>
    <DataGridCheckBoxColumn Header="Seç" Binding="{Binding [Seç], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="52"/>
    <DataGridTextColumn Header="Taksit No" Binding="{Binding [Taksit No]}" IsReadOnly="True" Width="90"/>
    <DataGridTextColumn Header="Vade Tarihi" Binding="{Binding Vade, StringFormat=dd.MM.yyyy}" IsReadOnly="True" Width="115"/>
    <DataGridTextColumn Header="Taksit Tutarı" Binding="{Binding Tutar, StringFormat=N2}" IsReadOnly="True" Width="120"/>
    <DataGridTextColumn Header="Ödenen" Binding="{Binding Ödenen, StringFormat=N2}" IsReadOnly="True" Width="110"/>
    <DataGridTextColumn Header="Kalan Tutar" Binding="{Binding Kalan, StringFormat=N2}" IsReadOnly="True" Width="125"/>
    <DataGridTextColumn Header="Tahsilat Tutarı" Binding="{Binding [Tahsilat], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="140"/>
    <DataGridTextColumn Header="Döviz" Binding="{Binding Döviz}" IsReadOnly="True" Width="80"/>
   </DataGrid.Columns>
  </DataGrid>
 </DockPanel>
</Window>
