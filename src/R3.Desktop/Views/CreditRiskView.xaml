<UserControl x:Class="R3.Desktop.Views.CreditRiskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:R3.Desktop.ViewModels"
             xmlns:local="clr-namespace:R3.Desktop"
             d:DataContext="{d:DesignInstance Type=vm:CreditRiskViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2V" />
            <local:RiskStatusBrushConverter x:Key="RiskStatusBrush" />
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Risk &amp; Kredi" FontSize="{StaticResource R3.Font.Kpi}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <ui:Button Content="Yenile (F5)" Command="{Binding RefreshCommand}" Padding="10,5"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="Firebrick" Margin="0,8,0,0"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
            <DataGrid Grid.Column="0" Style="{StaticResource ProfessionalDataGridStyle}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" Margin="0,0,10,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Cari Kodu" Binding="{Binding Code}" Width="100"/>
                    <DataGridTextColumn Header="Müşteri" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Bakiye" Binding="{Binding Balance, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="Kredi Limiti" Binding="{Binding CreditLimit, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="Ek Limit" Binding="{Binding ExtraCreditLimit, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="Bloke" Binding="{Binding BlockedCreditAmount, StringFormat=N2}" Width="90"/>
                    <DataGridTextColumn Header="Efektif Limit" Binding="{Binding EffectiveCreditLimit, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="Kullanılabilir" Binding="{Binding AvailableCredit, StringFormat=N2}" Width="110"/>
                    <DataGridTemplateColumn Header="Kullanım %" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ProgressBar Value="{Binding UsagePercent, Mode=OneWay}" Maximum="100" Height="14" Foreground="{Binding Status, Converter={StaticResource RiskStatusBrush}}"/>
                                    <TextBlock Text="{Binding UsagePercent, StringFormat={}{0}%}" HorizontalAlignment="Center" FontSize="{StaticResource R3.Font.Grid}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Risk Durumu" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource RiskStatusBrush}}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="1" Background="{StaticResource R3.Surface.Alt.Brush}" BorderBrush="{StaticResource R3.Border.Brush}" BorderThickness="1" CornerRadius="7" Padding="14" VerticalAlignment="Top"
                    Visibility="{Binding Selected, Converter={StaticResource B2V}}" DataContext="{Binding Selected}">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="{StaticResource R3.Font.Title}" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding Code}" Foreground="{StaticResource R3.Text.Secondary.Brush}" FontSize="{StaticResource R3.Font.Caption}" Margin="0,0,0,12"/>
                    <TextBlock Text="Mevcut Bakiye" Foreground="{StaticResource R3.Text.Secondary.Brush}" FontSize="{StaticResource R3.Font.Grid}"/><TextBlock Text="{Binding Balance, StringFormat=N2}" FontSize="{StaticResource R3.Font.Title}" FontWeight="SemiBold" Margin="0,1,0,10"/>
                    <TextBlock Text="Kredi Limiti" Foreground="{StaticResource R3.Text.Secondary.Brush}" FontSize="{StaticResource R3.Font.Grid}"/><TextBlock Text="{Binding CreditLimit, StringFormat=N2}" FontSize="{StaticResource R3.Font.Title}" FontWeight="SemiBold" Margin="0,1,0,10"/>
                    <TextBlock Text="Ek Kredi Limiti" Foreground="{StaticResource R3.Text.Secondary.Brush}" FontSize="{StaticResource R3.Font.Grid}"/><TextBlock Text="{Binding ExtraCreditLimit, StringFormat=N2}" FontSize="{StaticResource R3.Font.Title}" FontWeight="SemiBold" Margin="0,1,0,10"/>
                    <TextBlock Text="Bloke Kredi" Foreground="{StaticResource R3.Text.Secondary.Brush}" FontSize="{StaticResource R3.Font.Grid}"/><TextBlock Text="{Binding BlockedCreditAmount, StringFormat=N2}" FontSize="{StaticResource R3.Font.Title}" FontWeight="SemiBold" Margin="0,1,0,10"/>
                    <Separator Margin="0,0,0,10"/>
                    <TextBlock Text="Kullanılabilir Limit" Foreground="{StaticResource R3.Text.Secondary.Brush}" FontSize="{StaticResource R3.Font.Grid}"/><TextBlock Text="{Binding AvailableCredit, StringFormat=N2}" FontSize="{StaticResource R3.Font.Title}" FontWeight="Bold" Foreground="{StaticResource R3.Accent.Brush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
