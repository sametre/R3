<Window x:Class="R3.Desktop.Views.AccountEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:R3.Desktop.ViewModels"
        xmlns:local="clr-namespace:R3.Desktop"
        d:DataContext="{d:DesignInstance Type=vm:AccountEditViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
        Title="{Binding Title}" Width="1100" Height="750" MinWidth="920" MinHeight="620" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" Background="White" FontFamily="Segoe UI"
        Closing="Window_Closing">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2V" />
            <local:InverseBooleanToVisibilityConverter x:Key="InverseB2V" />
            <local:PinnedBrushConverter x:Key="PinnedBrush" />
            <local:BalanceStatusBrushConverter x:Key="BalanceStatusBrush" />
            <Style TargetType="TextBlock" x:Key="SectionTitle"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Foreground" Value="#3C3C3C"/></Style>
            <Style TargetType="TextBlock" x:Key="FieldLabel"><Setter Property="Margin" Value="0,10,0,5"/><Setter Property="Foreground" Value="#636363"/><Setter Property="FontSize" Value="11"/></Style>
            <Style TargetType="Border" x:Key="SectionCard"><Setter Property="Background" Value="#FBFBFB"/><Setter Property="BorderBrush" Value="#E8E8E8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Background="#F4F4F4" BorderBrush="#D4D4D4" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="18" FontWeight="SemiBold"><Run Text="{Binding Code}"/><Run Text="   "/><Run Text="{Binding Name}"/></TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <TextBlock Text="{Binding AccountTypeLabel}" Foreground="#666666"/>
                        <TextBlock Text="  •  " Visibility="{Binding IsExisting, Converter={StaticResource B2V}}"/>
                        <TextBlock Text="{Binding BalanceStatus}" Foreground="{Binding BalanceStatus, Converter={StaticResource BalanceStatusBrush}}" FontWeight="SemiBold" Visibility="{Binding IsExisting, Converter={StaticResource B2V}}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Visibility="{Binding IsExisting, Converter={StaticResource B2V}}"><TextBlock Text="Bakiye" Foreground="#848484" FontSize="10"/><TextBlock Text="{Binding Balance, StringFormat=N2}" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Grid.Column="2" Visibility="{Binding IsExisting, Converter={StaticResource B2V}}"><TextBlock Text="Kredi Limiti" Foreground="#848484" FontSize="10"/><TextBlock Text="{Binding EffectiveCreditLimit, StringFormat=N2}" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Grid.Column="3" Visibility="{Binding IsExisting, Converter={StaticResource B2V}}"><TextBlock Text="Kullanılabilir" Foreground="#848484" FontSize="10"/><TextBlock Text="{Binding AvailableCredit, StringFormat=N2}" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
            </Grid>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,0,0,4" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="#2A9D8F" TextWrapping="Wrap" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Kapat" Command="{Binding CloseCommand}" Width="78" Height="30" Padding="10,4" Margin="0,0,7,0" />
                <ui:Button Width="140" Height="30" Padding="10,4" Appearance="Primary" IsDefault="True" Command="{Binding SaveCommand}">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button">
                            <Setter Property="Content" Value="Kaydet" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNew}" Value="True"><Setter Property="Content" Value="Cari Oluştur" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
            </StackPanel>
        </StackPanel>

        <TabControl>
            <!-- ===================== GENEL ===================== -->
            <TabItem Header="Genel">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="18">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Kimlik" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Cari Kodu *" Style="{StaticResource FieldLabel}"/><ui:TextBox x:Name="CodeBox" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" TabIndex="0"/>
                                <TextBlock Text="Cari hesabın sistem içerisindeki benzersiz kodu." Foreground="#A5A5A5" FontSize="10" Margin="0,3,0,0"/>
                                <TextBlock Text="Cari Adı *" Style="{StaticResource FieldLabel}"/><ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>
                                <TextBlock Text="Kısa Ad" Style="{StaticResource FieldLabel}"/><ui:TextBox Text="{Binding ShortName, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"/>
                                <TextBlock Text="Cari Tipi *" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding AccountTypes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding AccountType}" Padding="8"/>
                                <TextBlock Text="Telefon" Style="{StaticResource FieldLabel}"/><ui:TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="30"/>
                                <TextBlock Text="Cep Telefonu" Style="{StaticResource FieldLabel}"/><ui:TextBox Text="{Binding MobilePhone, UpdateSourceTrigger=PropertyChanged}" MaxLength="30"/>
                                <TextBlock Text="E-posta" Style="{StaticResource FieldLabel}"/><ui:TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="160"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Durum" Style="{StaticResource SectionTitle}"/>
                                <ui:ToggleSwitch Content="Aktif Cari" IsChecked="{Binding IsActive}"/>
                                <ui:ToggleSwitch Content="Aktif Alıcı" IsChecked="{Binding IsActiveBuyer}" Margin="0,10,0,0" Visibility="{Binding ShowCustomerFields, Converter={StaticResource B2V}}"/>
                                <ui:ToggleSwitch Content="Aktif Tedarikçi" IsChecked="{Binding IsActiveSupplier}" Margin="0,10,0,0" Visibility="{Binding ShowSupplierFields, Converter={StaticResource B2V}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Ticari Bilgiler" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Cari Grubu" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding AccountGroups}" DisplayMemberPath="Ad" SelectedValuePath="Id" SelectedValue="{Binding AccountGroupId}" Padding="8" IsEditable="False"/>
                                <TextBlock Text="Bölge" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Regions}" DisplayMemberPath="Ad" SelectedValuePath="Id" SelectedValue="{Binding RegionId}" Padding="8"/>
                                <TextBlock Text="Varsayılan Para Birimi" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Currencies}" DisplayMemberPath="Kod" SelectedValuePath="Kod" SelectedValue="{Binding DefaultCurrencyCode}" Padding="8"/>
                                <TextBlock Text="Dil" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding PreferredLanguageCode}" Padding="8"/>
                                <StackPanel Visibility="{Binding ShowCustomerFields, Converter={StaticResource B2V}}">
                                    <TextBlock Text="Satış Temsilcisi" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding SalesRepresentatives}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SalesRepresentativeId}" Padding="8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Vergi Bilgileri" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Kişi / Firma Tipi" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding PersonTypes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding PersonType}" Padding="8"/>
                                <StackPanel Visibility="{Binding ShowTaxNumber, Converter={StaticResource B2V}}">
                                    <TextBlock Text="Ticari Ünvan" Style="{StaticResource FieldLabel}"/><ui:TextBox Text="{Binding LegalTitle, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>
                                    <TextBlock Text="Vergi Dairesi" Style="{StaticResource FieldLabel}"/><ui:TextBox Text="{Binding TaxOffice, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/>
                                    <TextBlock Text="Vergi Numarası (10 hane)" Style="{StaticResource FieldLabel}"/><ui:TextBox Text="{Binding TaxNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="10"/>
                                    <TextBlock Text="Ticaret Sicil No" Style="{StaticResource FieldLabel}"/><ui:TextBox Text="{Binding TradeRegistryNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding ShowNationalIdentity, Converter={StaticResource B2V}}">
                                    <TextBlock Text="T.C. Kimlik No (11 hane)" Style="{StaticResource FieldLabel}"/><ui:TextBox Text="{Binding IdentityNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="11"/>
                                </StackPanel>
                                <TextBlock Text="Ülke" Style="{StaticResource FieldLabel}"/><ui:TextBox Text="{Binding CountryCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="2"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid></ScrollViewer>
            </TabItem>

            <!-- ===================== ADRESLER & YETKİLİLER ===================== -->
            <TabItem Header="Adresler &amp; Yetkililer">
                <Grid>
                    <TextBlock Text="Adres ve yetkili kayıtları, cari kartı ilk kez kaydettikten sonra bu sekmede yönetilebilir." Foreground="#848484" TextWrapping="Wrap" Margin="18,22,18,18"
                               Visibility="{Binding IsNew, Converter={StaticResource B2V}}"/>
                    <ContentControl x:Name="AddressesContactsHost" Visibility="{Binding IsExisting, Converter={StaticResource B2V}}"/>
                </Grid>
            </TabItem>

            <!-- ===================== BANKA HESAPLARI ===================== -->
            <TabItem Header="Banka Hesapları">
                <Grid Margin="18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Visibility="{Binding IsExisting, Converter={StaticResource B2V}}">
                        <ui:Button Content="+ Banka Hesabı" Appearance="Primary" Click="AddBank_Click" Padding="12,6" Margin="0,0,8,0"/>
                        <ui:Button Content="Düzenle" Click="EditBank_Click" Padding="12,6" Margin="0,0,8,0"/>
                        <ui:Button Content="Pasife Al" Command="{Binding BankAccounts.DeactivateCommand}" Padding="12,6"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Banka hesapları cari kartı kaydedildikten sonra eklenebilir." Foreground="#848484" Visibility="{Binding IsNew, Converter={StaticResource B2V}}"/>
                    <DataGrid Grid.Row="1" Grid.RowSpan="1" Style="{StaticResource ProfessionalDataGridStyle}" ItemsSource="{Binding BankAccounts.Banks}" SelectedItem="{Binding BankAccounts.Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Visibility="{Binding IsExisting, Converter={StaticResource B2V}}">
                        <DataGrid.Columns><DataGridTextColumn Header="Banka" Binding="{Binding BankName}" Width="180"/><DataGridTextColumn Header="Şube" Binding="{Binding BranchName}" Width="140"/><DataGridTextColumn Header="Hesap Adı" Binding="{Binding AccountName}" Width="150"/><DataGridTextColumn Header="IBAN" Binding="{Binding Iban}" Width="240"/><DataGridTextColumn Header="Döviz" Binding="{Binding CurrencyCode}" Width="65"/><DataGridTextColumn Header="Durum" Binding="{Binding StatusLabel}" Width="100"/></DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="{Binding BankAccounts.StatusMessage}" Foreground="Firebrick" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>

            <!-- ===================== FİNANS ===================== -->
            <TabItem Header="Finans">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="18">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Finansal Durum" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock Text="Bakiye" Foreground="#848484" FontSize="10"/><TextBlock Text="{Binding Balance, StringFormat=N2}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Bakiye Durumu" Foreground="#848484" FontSize="10"/><TextBlock Text="{Binding BalanceStatus}" FontSize="18" FontWeight="SemiBold" Foreground="{Binding BalanceStatus, Converter={StaticResource BalanceStatusBrush}}"/></StackPanel>
                                </Grid>
                                <TextBlock Text="Finansal bakiye AccountBalance projeksiyonundan okunur; bu ekranda yeniden hesaplanmaz." Foreground="#A5A5A5" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Kredi / Risk Ayarları" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Kredi Limiti" Style="{StaticResource FieldLabel}"/><ui:TextBox Text="{Binding CreditLimit, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Ek Kredi Limiti" Style="{StaticResource FieldLabel}"/><ui:TextBox Text="{Binding ExtraCreditLimit, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Bloke Kredi" Style="{StaticResource FieldLabel}"/><ui:TextBox Text="{Binding BlockedCreditAmount, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Risk Limiti" Style="{StaticResource FieldLabel}"/><ui:TextBox Text="{Binding RiskLimit, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Kredi Kontrol Tipi" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding CreditControlTypes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding CreditControlType}" Padding="8"/>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock Text="Efektif Limit" Foreground="#848484" FontSize="10"/><TextBlock Text="{Binding EffectiveCreditLimit, StringFormat=N2}" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Kullanılabilir Limit" Foreground="#848484" FontSize="10"/><TextBlock Text="{Binding AvailableCredit, StringFormat=N2}" FontSize="15" FontWeight="SemiBold" Foreground="#2A9D8F"/></StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid></ScrollViewer>
            </TabItem>

            <!-- ===================== SATIŞ / ALIŞ ===================== -->
            <TabItem Header="Satış / Alış">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
                    <Border Style="{StaticResource SectionCard}" Visibility="{Binding ShowCustomerFields, Converter={StaticResource B2V}}">
                        <StackPanel>
                            <TextBlock Text="Müşteri Satış Ayarları" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Müşteri Grubu" Style="{StaticResource FieldLabel}"/><ui:TextBox Text="{Binding CustomerGroup, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Fiyat Listesi" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding PriceLists}" DisplayMemberPath="Ad" SelectedValuePath="Id" SelectedValue="{Binding PriceListId}" Padding="8"/>
                                    <TextBlock Text="Varsayılan İskonto %" Style="{StaticResource FieldLabel}"/><ui:TextBox Text="{Binding DiscountRate, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Vade Günü" Style="{StaticResource FieldLabel}"/><ui:TextBox Text="{Binding PaymentTermDays, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Varsayılan Ödeme Yöntemi" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding PaymentMethods}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DefaultPaymentMethod}" Padding="8"/>
                                    <TextBlock Text="Müşteri Başlangıç Tarihi" Style="{StaticResource FieldLabel}"/><DatePicker SelectedDate="{Binding CustomerStartedAt}"/>
                                    <ui:ToggleSwitch Content="Sipariş Alımına İzin Ver" IsChecked="{Binding AllowOrders}" Margin="0,14,0,0"/>
                                    <ui:ToggleSwitch Content="KVKK Onayı" IsChecked="{Binding KvkkConsent}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SectionCard}" Visibility="{Binding ShowSupplierFields, Converter={StaticResource B2V}}">
                        <StackPanel>
                            <TextBlock Text="Tedarikçi Alış Ayarları" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Tedarikçi Grubu" Style="{StaticResource FieldLabel}"/><ui:TextBox Text="{Binding SupplierGroup, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Varsayılan Para Birimi" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Currencies}" DisplayMemberPath="Kod" SelectedValuePath="Kod" SelectedValue="{Binding SupplierDefaultCurrencyCode}" Padding="8"/>
                                    <TextBlock Text="Vade Günü" Style="{StaticResource FieldLabel}"/><ui:TextBox Text="{Binding SupplierPaymentTermDays, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Termin Süresi (gün)" Style="{StaticResource FieldLabel}"/><ui:TextBox Text="{Binding LeadTimeDays, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Not" Style="{StaticResource FieldLabel}"/><ui:TextBox Text="{Binding SupplierNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="60"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel></ScrollViewer>
            </TabItem>

            <!-- ===================== E-BELGE ===================== -->
            <TabItem Header="E-Belge">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18" Width="520" HorizontalAlignment="Left">
                    <Border Background="#F4F4F4" BorderBrush="#D6D6D6" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Bu bilgiler elektronik belge gönderimlerinde kullanılacaktır." TextWrapping="Wrap" Foreground="#4C4C4C"/>
                            <TextBlock Text="Bu ekran GİB mükellefiyet sorgulaması yapmaz." TextWrapping="Wrap" Foreground="#4C4C4C" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <ui:ToggleSwitch Content="E-Fatura Kullanıyor" IsChecked="{Binding IsEInvoiceEnabled}"/>
                    <TextBlock Text="E-Fatura Alias" Style="{StaticResource FieldLabel}"/>
                    <ui:TextBox Text="{Binding EinvoiceAlias, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEInvoiceEnabled}"/>
                    <TextBlock Text="Fatura Senaryosu" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding InvoiceScenarios}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding InvoiceScenario}" Padding="8" IsEnabled="{Binding IsEInvoiceEnabled}"/>
                    <ui:ToggleSwitch Content="E-İrsaliye Kullanıyor" IsChecked="{Binding IsEDispatchEnabled}" Margin="0,16,0,0"/>
                    <TextBlock Text="E-İrsaliye Alias" Style="{StaticResource FieldLabel}"/>
                    <ui:TextBox Text="{Binding EdispatchAlias, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEDispatchEnabled}"/>
                    <ui:ToggleSwitch Content="GİB Uyumlu Hesaplama" IsChecked="{Binding IsGibCompliant}" Margin="0,16,0,0"/>
                    <ui:ToggleSwitch Content="Fatura Yazdır" IsChecked="{Binding PrintInvoice}" Margin="0,10,0,0"/>
                </StackPanel></ScrollViewer>
            </TabItem>

            <!-- ===================== HAREKETLER ===================== -->
            <TabItem Header="Hareketler">
                <Grid>
                    <TextBlock Text="Bu cari için henüz finansal hareket bulunmuyor." Foreground="#848484" Margin="18" Visibility="{Binding IsNew, Converter={StaticResource B2V}}"/>
                    <DockPanel Margin="18" Visibility="{Binding IsExisting, Converter={StaticResource B2V}}">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:Button Content="Manuel Hareket" Click="ManualEntry_Click" Padding="10,5" Margin="0,0,10,0"/>
                            <TextBlock Text="Ayrıntılı hesap ekstresi için Cari &gt; Cari Ekstre menüsünü kullanın." Foreground="#A5A5A5" FontSize="10.5" VerticalAlignment="Center"/>
                        </StackPanel>
                        <DataGrid Style="{StaticResource ProfessionalDataGridStyle}" ItemsSource="{Binding Ledger.Transactions}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tarih" Binding="{Binding Date}" Width="140"/>
                                <DataGridTextColumn Header="İşlem" Binding="{Binding TransactionType}" Width="110"/>
                                <DataGridTextColumn Header="Belge No" Binding="{Binding DocumentNo}" Width="120"/>
                                <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="2*"/>
                                <DataGridTextColumn Header="Borç" Binding="{Binding Debit, StringFormat=N2}" Width="100"/>
                                <DataGridTextColumn Header="Alacak" Binding="{Binding Credit, StringFormat=N2}" Width="100"/>
                                <DataGridTextColumn Header="Döviz" Binding="{Binding Currency}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ===================== BELGELER ===================== -->
            <TabItem Header="Belgeler">
                <Grid>
                    <TextBlock Text="Bu cari için henüz belge bulunmuyor." Foreground="#848484" Margin="18" Visibility="{Binding IsNew, Converter={StaticResource B2V}}"/>
                    <TabControl Margin="12" Visibility="{Binding IsExisting, Converter={StaticResource B2V}}">
                        <TabItem Header="Faturalar">
                            <Grid>
                                <TextBlock Text="Bu cari için henüz kayıt bulunmuyor." Foreground="#848484" Margin="18" Visibility="{Binding Documents.HasInvoices, Converter={StaticResource InverseB2V}}"/>
                                <DataGrid Style="{StaticResource ProfessionalDataGridStyle}" ItemsSource="{Binding Documents.Invoices}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Margin="6"
                                          Visibility="{Binding Documents.HasInvoices, Converter={StaticResource B2V}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tarih" Binding="{Binding Date}" Width="140"/>
                                        <DataGridTextColumn Header="Belge No" Binding="{Binding DocumentNo}" Width="140"/>
                                        <DataGridTextColumn Header="Tip" Binding="{Binding Type}" Width="110"/>
                                        <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="110"/>
                                        <DataGridTextColumn Header="Döviz" Binding="{Binding Currency}" Width="70"/>
                                        <DataGridTextColumn Header="Tutar" Binding="{Binding Total, StringFormat=N2}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Siparişler">
                            <TextBlock Text="Bu cari için henüz kayıt bulunmuyor." Foreground="#848484" Margin="18"/>
                        </TabItem>
                        <TabItem Header="Tahsilatlar">
                            <DataGrid Style="{StaticResource ProfessionalDataGridStyle}" ItemsSource="{Binding Documents.Receipts}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Margin="6">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tarih" Binding="{Binding Date}" Width="140"/>
                                    <DataGridTextColumn Header="Belge No" Binding="{Binding DocumentNo}" Width="140"/>
                                    <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="2*"/>
                                    <DataGridTextColumn Header="Tutar" Binding="{Binding Credit, StringFormat=N2}" Width="120"/>
                                    <DataGridTextColumn Header="Döviz" Binding="{Binding Currency}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Ödemeler">
                            <DataGrid Style="{StaticResource ProfessionalDataGridStyle}" ItemsSource="{Binding Documents.Payments}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Margin="6">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tarih" Binding="{Binding Date}" Width="140"/>
                                    <DataGridTextColumn Header="Belge No" Binding="{Binding DocumentNo}" Width="140"/>
                                    <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="2*"/>
                                    <DataGridTextColumn Header="Tutar" Binding="{Binding Debit, StringFormat=N2}" Width="120"/>
                                    <DataGridTextColumn Header="Döviz" Binding="{Binding Currency}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <!-- ===================== NOTLAR ===================== -->
            <TabItem Header="Notlar">
                <Grid>
                    <TextBlock Text="Notlar, cari kartı ilk kez kaydettikten sonra eklenebilir." Foreground="#848484" Margin="18" Visibility="{Binding IsNew, Converter={StaticResource B2V}}"/>
                    <DockPanel Margin="18" Visibility="{Binding IsExisting, Converter={StaticResource B2V}}">
                        <ui:Button DockPanel.Dock="Top" Content="+ Not Ekle" Click="AddNote_Click" HorizontalAlignment="Left" Padding="12,6" Appearance="Primary" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Notes.Notes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding IsPinned, Converter={StaticResource PinnedBrush}}" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="{Binding NoteType}" HorizontalAlignment="Right" Foreground="#848484" FontSize="10"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Margin="0,6,0,6"/>
                                            <TextBlock Foreground="#A5A5A5" FontSize="10"><Run Text="{Binding CreatedBy}"/><Run Text=" • "/><Run Text="{Binding CreatedAt}"/></TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ===================== GEÇMİŞ ===================== -->
            <TabItem Header="Geçmiş">
                <Grid>
                    <TextBlock Text="Geçmiş, cari kartı ilk kez kaydettikten sonra görüntülenebilir." Foreground="#848484" Margin="18" Visibility="{Binding IsNew, Converter={StaticResource B2V}}"/>
                    <DataGrid Style="{StaticResource ProfessionalDataGridStyle}" ItemsSource="{Binding History.Entries}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Margin="18"
                              Visibility="{Binding IsExisting, Converter={StaticResource B2V}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tarih" Binding="{Binding Date}" Width="160"/>
                            <DataGridTextColumn Header="Kullanıcı" Binding="{Binding User}" Width="120"/>
                            <DataGridTextColumn Header="Alan" Binding="{Binding Entity}" Width="120"/>
                            <DataGridTextColumn Header="İşlem" Binding="{Binding Action}" Width="150"/>
                            <DataGridTextColumn Header="Eski Değer" Binding="{Binding OldValue}" Width="150"/>
                            <DataGridTextColumn Header="Yeni Değer" Binding="{Binding NewValue}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
