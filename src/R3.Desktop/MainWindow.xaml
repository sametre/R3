<ui:FluentWindow x:Class="R3.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:controls="clr-namespace:R3.Desktop.Controls"
 Title="R3 ERP — İşletme Yönetimi" Width="1440" Height="900" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen" Background="#EEF1F3" FontFamily="Segoe UI" Foreground="#29343D" Icon="Assets/R3.ico" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <ui:TitleBar Grid.Row="0" Title="R3 ERP — İşletme Yönetimi" Height="32" CloseWindowByDoubleClickOnIcon="True"/>
  <DockPanel Grid.Row="1">
  <Border DockPanel.Dock="Top" Background="#ECEFF1" BorderBrush="#C8CDD1" BorderThickness="0,0,0,1" Padding="9,4">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="● HAZIR" Foreground="#26866D" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <controls:R3BrandMark Width="38" Height="25"/>
     <TextBlock Text="R3 ERP" Foreground="#33414C" FontWeight="Bold" FontSize="14" Margin="7,0,0,0" VerticalAlignment="Center"/>
     <TextBlock Text="İşletme Yönetimi" Foreground="#7B858D" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"/>
   </StackPanel>
   </DockPanel>
  </Border>
  <Border DockPanel.Dock="Top" Background="#F8FAFB" BorderBrush="#C8CDD1" BorderThickness="0,0,0,1" Padding="4,3">
    <Menu x:Name="MainMenu" Background="Transparent" Padding="0" FontSize="10" HorizontalAlignment="Stretch">
     <Menu.ItemsPanel><ItemsPanelTemplate><WrapPanel IsItemsHost="True" Orientation="Horizontal"/></ItemsPanelTemplate></Menu.ItemsPanel>
    </Menu>
  </Border>
  <Border DockPanel.Dock="Top" Height="4" Background="#299BE6"/>
  <Border DockPanel.Dock="Bottom" Height="36" Background="#075B7B" BorderBrush="#064A65" BorderThickness="0,1,0,0" Padding="7,4">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="Firma" Foreground="#BFE8F5" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,4,0"/>
     <ComboBox x:Name="CompanyContextCombo" Width="132" Height="24" FontSize="9.5" Margin="0,0,8,0" Background="#F7FAFC" Foreground="#263746" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="CompanyContextCombo_SelectionChanged"/>
     <TextBlock Text="Şube" Foreground="#BFE8F5" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,4,0"/>
     <ComboBox x:Name="BranchContextCombo" Width="112" Height="24" FontSize="9.5" Margin="0,0,8,0" Background="#F7FAFC" Foreground="#263746" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="BranchContextCombo_SelectionChanged"/>
     <TextBlock Text="Depo" Foreground="#BFE8F5" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,4,0"/>
     <ComboBox x:Name="WarehouseContextCombo" Width="112" Height="24" FontSize="9.5" Background="#F7FAFC" Foreground="#263746" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="WarehouseContextCombo_SelectionChanged"/>
     <TextBlock x:Name="ContextStatus" Visibility="Collapsed"/>
    </StackPanel>
    <TextBlock Grid.Column="1" x:Name="DatabaseStatus" Text="SQLite 3 • Bağlanıyor…" Foreground="#F0F7FA" FontSize="9.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="14,0"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="R3 ERP • 0.3.0" Foreground="#BFE8F5" FontSize="9.5" Margin="0,0,13,0"/>
     <TextBlock x:Name="DateText" Foreground="#F0F7FA" FontSize="9.5"/>
    </StackPanel>
   </Grid>
  </Border>
  <Border Margin="3" Background="#FFFFFF" BorderBrush="#AEB8C0" BorderThickness="1" CornerRadius="0">
   <TabControl x:Name="Workspace" Background="Transparent" BorderThickness="0" PreviewMouseRightButtonDown="Workspace_PreviewMouseRightButtonDown">
    <TabControl.ContextMenu>
     <ContextMenu>
      <MenuItem Header="Bu sekmeyi kapat" Click="CloseCurrentTab_Click"/>
      <MenuItem Header="Soldaki sekmeleri kapat" Click="CloseTabsToLeft_Click"/>
      <MenuItem Header="Sağdaki sekmeleri kapat" Click="CloseTabsToRight_Click"/>
      <MenuItem Header="Diğer sekmeleri kapat" Click="CloseOtherTabs_Click"/>
      <MenuItem Header="Tüm çalışma sekmelerini kapat" Click="CloseAllTabs_Click"/>
      <Separator/>
      <MenuItem Header="Son kapatılan sekmeyi aç" Click="ReopenClosedTab_Click"/>
      <MenuItem Header="Sekme başlığını kopyala" Click="CopyTabTitle_Click"/>
      <Separator/>
      <MenuItem Header="Giriş ekranına dön" Click="GoHome_Click"/>
     </ContextMenu>
    </TabControl.ContextMenu>
    <TabItem Header="  Giriş  ">
     <Grid Background="#FFFFFF">
      <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="820" Height="330">
       <Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="1"/><ColumnDefinition Width="389"/></Grid.ColumnDefinitions>
       <Canvas Grid.Column="0" Width="400" Height="280">
        <Ellipse Canvas.Left="42" Canvas.Top="68" Width="138" Height="138" Fill="#145C78"/>
        <Ellipse Canvas.Left="135" Canvas.Top="42" Width="190" Height="190" Fill="#6C7A89"/>
        <Ellipse Canvas.Left="22" Canvas.Top="165" Width="92" Height="92" Fill="#35A9D4"/>
        <Ellipse Canvas.Left="92" Canvas.Top="177" Width="110" Height="110" Fill="#A7B1B8"/>
        <Ellipse Canvas.Left="184" Canvas.Top="200" Width="76" Height="76" Fill="#168E8A"/>
        <TextBlock Canvas.Left="84" Canvas.Top="124" Text="Cari" Foreground="White" FontWeight="SemiBold"/>
        <TextBlock Canvas.Left="188" Canvas.Top="127" Text="R3 ERP" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Canvas.Left="45" Canvas.Top="202" Text="Stok" Foreground="White"/>
        <TextBlock Canvas.Left="118" Canvas.Top="219" Text="E-Belge" Foreground="White"/>
        <TextBlock Canvas.Left="201" Canvas.Top="229" Text="Satış" Foreground="White"/>
       </Canvas>
       <Border Grid.Column="1" Background="#2B789D" Margin="0,10"/>
       <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="74,0,0,0">
        <controls:R3BrandMark Width="128" Height="86" HorizontalAlignment="Left"/>
        <TextBlock Text="R3 ERP" Foreground="#235E7B" FontSize="25" FontWeight="SemiBold" Margin="0,17,0,2"/>
        <TextBlock Text="Ticari işletmenizin merkezi" Foreground="#6F7E88" FontSize="13"/>
        <TextBlock Text="Satış • Stok • Cari • Finans" Foreground="#95A0A7" FontSize="10" Margin="0,10,0,0"/>
       </StackPanel>
      </Grid>
     </Grid>
    </TabItem>
   </TabControl>
  </Border>
  </DockPanel>
 </Grid>
</ui:FluentWindow>
