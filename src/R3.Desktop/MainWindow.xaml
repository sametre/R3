<ui:FluentWindow x:Class="R3.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:controls="clr-namespace:R3.Desktop.Controls" xmlns:fluent="urn:fluent-ribbon" xmlns:xcad="https://github.com/Dirkster99/AvalonDock" xmlns:xcadControls="clr-namespace:AvalonDock.Controls;assembly=AvalonDock" xmlns:xcadThemes="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.Aero"
 Title="AR3 ERP — İşletme Yönetimi" Width="1440" Height="900" MinWidth="1080" MinHeight="680" WindowStartupLocation="CenterScreen" Background="{DynamicResource R3.Background.Brush}" FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{DynamicResource R3.Text.Primary.Brush}" Icon="Assets/AR3.ico" ExtendsContentIntoTitleBar="True" WindowBackdropType="None">
 <ui:FluentWindow.Resources>
   <Style TargetType="Menu">
    <Setter Property="Background" Value="#F1F3F5"/>
    <Setter Property="Foreground" Value="#26343D"/>
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
  </Style>
   <!-- Base MenuItem look. The three role-keyed ControlTemplates below (top bar item,
        flyout group header, flyout leaf item) do the actual visual work; this Style just
        supplies the inherited defaults (font/foreground/row height/icon-column padding)
        those templates read via TemplateBinding, so every menu level shares one language:
        rounded hover, a reserved icon column so leaf rows line up whether or not they carry
        an icon, and the brand accent (matches the orange strip under the header and every
        button/tab in the app) instead of the old one-off teal highlight. -->
   <Style TargetType="MenuItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#26343D"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="10,6,22,6"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="FontSize" Value="11.5"/>
   </Style>
   <ControlTemplate x:Key="{x:Static MenuItem.TopLevelHeaderTemplateKey}" TargetType="MenuItem">
    <Grid SnapsToDevicePixels="True">
     <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Margin="3,4" Padding="{TemplateBinding Padding}">
      <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
     </Border>
     <Border x:Name="ActiveBar" Height="2" VerticalAlignment="Bottom" Margin="10,0" Background="{DynamicResource R3.Accent.Brush}" Visibility="Collapsed"/>
     <Popup x:Name="PART_Popup" Placement="Bottom" HorizontalOffset="-3" VerticalOffset="2" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
      <Border Background="#F7F8F9" BorderBrush="#C8D0D5" BorderThickness="1" CornerRadius="6" Padding="3" MinWidth="190" SnapsToDevicePixels="True">
       <Border.Effect><DropShadowEffect Color="#1F2937" Opacity="0.20" BlurRadius="18" ShadowDepth="5" Direction="270"/></Border.Effect>
       <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
      </Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentSoftBrush}"/></Trigger>
     <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentSoftBrush}"/><Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate>
   <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="MenuItem">
    <Grid SnapsToDevicePixels="True">
     <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Margin="3,1">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
       <ContentPresenter Grid.Column="0" ContentSource="Icon" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="4,7,4,7"/>
       <TextBlock Grid.Column="2" Text="›" FontSize="13" FontWeight="Bold" Foreground="#9AA3AC" VerticalAlignment="Center" HorizontalAlignment="Center"/>
      </Grid>
     </Border>
     <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-4" VerticalOffset="-5" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
      <Border Background="#F7F8F9" BorderBrush="#C8D0D5" BorderThickness="1" CornerRadius="6" Padding="3" MinWidth="190" SnapsToDevicePixels="True">
       <Border.Effect><DropShadowEffect Color="#1F2937" Opacity="0.20" BlurRadius="18" ShadowDepth="5" Direction="270"/></Border.Effect>
       <ItemsPresenter/>
      </Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate>
   <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="MenuItem">
    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Margin="3,1" SnapsToDevicePixels="True">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ContentPresenter Grid.Column="0" ContentSource="Icon" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="4,7,4,7"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate>
 </ui:FluentWindow.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <ui:TitleBar Grid.Row="0" Title="AR3 ERP — İşletme Yönetimi" Height="32" CloseWindowByDoubleClickOnIcon="True"/>
  <DockPanel Grid.Row="1">
   <Menu x:Name="MainMenu" Visibility="Visible" IsMainMenu="True" DockPanel.Dock="Top" Height="44" Background="#F1F3F5" BorderBrush="{DynamicResource R3.Border.Brush}" BorderThickness="0,0,0,1" Padding="6,0" FontSize="11.5" VerticalContentAlignment="Center"/>
  <fluent:Ribbon x:Name="MainRibbon" Visibility="Collapsed" DockPanel.Dock="Top" Height="0" MinHeight="0" IsMinimized="True"/>
  <Border DockPanel.Dock="Top" Height="3" Background="{DynamicResource R3.Accent.Brush}"/>
  <Border DockPanel.Dock="Bottom" Height="34" Background="{DynamicResource SidebarBrush}" BorderBrush="#374151" BorderThickness="0,1,0,0" Padding="12,4">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="Firma" Foreground="#DCE8EF" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
     <ComboBox x:Name="CompanyContextCombo" Width="132" Height="20" FontSize="9" Margin="0,0,8,0" Background="#FAFAFA" Foreground="#363636" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="CompanyContextCombo_SelectionChanged"/>
     <TextBlock Text="Şube" Foreground="#DCE8EF" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
     <ComboBox x:Name="BranchContextCombo" Width="112" Height="20" FontSize="9" Margin="0,0,8,0" Background="#FAFAFA" Foreground="#363636" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="BranchContextCombo_SelectionChanged"/>
     <TextBlock Text="Depo" Foreground="#DCE8EF" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
     <ComboBox x:Name="WarehouseContextCombo" Width="112" Height="20" FontSize="9" Background="#FAFAFA" Foreground="#363636" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="WarehouseContextCombo_SelectionChanged"/>
     <TextBlock x:Name="ContextStatus" Visibility="Collapsed"/>
    </StackPanel>
     <TextBlock Grid.Column="1" x:Name="DatabaseStatus" Text="SQLite 3 • Bağlanıyor…" Foreground="#DCE8EF" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="18,0"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="AR3 ERP • 0.3.0" Foreground="#B9CBD7" FontSize="10" Margin="0,0,13,0"/>
     <TextBlock x:Name="DateText" Foreground="#DCE8EF" FontSize="10"/>
    </StackPanel>
   </Grid>
  </Border>
  <Border Margin="10,8,10,8" Background="{DynamicResource R3.Surface.Brush}" BorderBrush="{DynamicResource R3.Border.Brush}" BorderThickness="1" CornerRadius="8" Padding="1">
   <xcad:DockingManager x:Name="Workspace" Background="{DynamicResource R3.Background.Brush}" UseLayoutRounding="True">
    <xcad:DockingManager.DocumentHeaderTemplate>
     <DataTemplate>
      <DockPanel LastChildFill="False" VerticalAlignment="Center" Margin="4,0,5,0">
       <TextBlock Text="{Binding Title}" Foreground="{DynamicResource R3.Text.Primary.Brush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
       <Button Content="×" Click="DocumentHeaderClose_Click" Style="{StaticResource DocumentCloseButtonStyle}"/>
      </DockPanel>
     </DataTemplate>
    </xcad:DockingManager.DocumentHeaderTemplate>
    <xcad:DockingManager.DocumentContextMenu>
     <ContextMenu>
      <MenuItem Header="Bu sekmeyi kapat" Click="CloseCurrentTab_Click"/>
      <MenuItem Header="Soldaki sekmeleri kapat" Click="CloseTabsToLeft_Click"/>
      <MenuItem Header="Sağdaki sekmeleri kapat" Click="CloseTabsToRight_Click"/>
      <MenuItem Header="Diğer sekmeleri kapat" Click="CloseOtherTabs_Click"/>
      <MenuItem Header="Tüm çalışma sekmelerini kapat" Click="CloseAllTabs_Click"/>
      <Separator/>
      <MenuItem Header="Son kapatılan sekmeyi aç" Click="ReopenClosedTab_Click"/>
      <MenuItem Header="Sekme başlığını kopyala" Click="CopyTabTitle_Click"/>
      <Separator/>
      <MenuItem Header="Giriş ekranına dön" Click="GoHome_Click"/>
     </ContextMenu>
    </xcad:DockingManager.DocumentContextMenu>
    <xcad:LayoutRoot>
     <xcad:LayoutPanel Orientation="Horizontal">
      <xcad:LayoutDocumentPane x:Name="DocumentsPane">
       <xcad:LayoutDocument x:Name="HomeDocument" Title="Giriş" CanClose="False" CanFloat="False" IsActive="True" IsSelected="True">
        <Grid Background="{DynamicResource R3.Background.Brush}">
         <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="860" Height="360" CornerRadius="16" Padding="34" BorderBrush="#D3D9DD" BorderThickness="1">
          <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3B454D" Offset="0"/><GradientStop Color="#58646D" Offset="1"/></LinearGradientBrush></Border.Background>
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
           <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="İşletmenizin çalışma alanı" Foreground="#B9D9DA" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock Text="AR3 ERP" Foreground="White" FontSize="48" FontWeight="Black" Margin="0,7,0,4"/>
            <TextBlock Text="Satış, stok, cari ve finans süreçlerini tek merkezden yönetin." Foreground="#D9E7F3" FontSize="13" TextWrapping="Wrap" MaxWidth="330"/>
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
             <Border Background="#167C82" CornerRadius="7" Padding="12,7" Margin="0,0,8,0"><TextBlock Text="Satış" Foreground="White" FontWeight="SemiBold"/></Border>
             <Border Background="#66717A" CornerRadius="7" Padding="12,7" Margin="0,0,8,0"><TextBlock Text="Stok" Foreground="White" FontWeight="SemiBold"/></Border>
             <Border Background="#89939A" CornerRadius="7" Padding="12,7"><TextBlock Text="Finans" Foreground="White" FontWeight="SemiBold"/></Border>
            </StackPanel>
           </StackPanel>
           <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Width="220" Height="230">
            <Ellipse Width="205" Height="205" Fill="#FFFFFF" Opacity="0.08" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Ellipse Width="150" Height="150" Fill="#FFFFFF" Opacity="0.08" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <controls:R3BrandMark Width="190" Height="128" HorizontalAlignment="Center" VerticalAlignment="Center"/>
           </Grid>
          </Grid>
         </Border>
        </Grid>
       </xcad:LayoutDocument>
      </xcad:LayoutDocumentPane>
     </xcad:LayoutPanel>
    </xcad:LayoutRoot>
   </xcad:DockingManager>
  </Border>
  </DockPanel>
 </Grid>
</ui:FluentWindow>
